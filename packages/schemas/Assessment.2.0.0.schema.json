        "priority": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "title": "Priority",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "requirement_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Requirement Ids",
          "type": "array"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
