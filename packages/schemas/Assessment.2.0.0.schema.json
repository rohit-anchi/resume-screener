        "fabrication_guard": {
          "default": "Only include this if it is true and you can evidence it in an interview.",
          "title": "Fabrication Guard",
          "type": "string"
        }
      },
      "required": [
        "recommendation_id",
        "kind",
        "priority",
        "title",
        "rationale"
