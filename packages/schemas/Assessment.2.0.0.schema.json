      "enum": [
        "critical_application_gap",
        "make_evidence_explicit",
        "section_ordering",
        "targeted_summary",
        "terminology_alignment",
        "quantify_achievement",
        "skill_needs_context",
        "reduce_or_remove",
        "application_field_care"
