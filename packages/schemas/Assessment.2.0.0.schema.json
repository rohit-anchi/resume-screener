{
  "$defs": {
    "AtsDetection": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "2.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "listing_source": {
          "default": "linkedin",
          "title": "Listing Source",
          "type": "string"
        },
        "application_platform": {
          "$ref": "#/$defs/AtsPlatform"
        },
        "application_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Application Url"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "signals": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AtsSignal"
          },
          "title": "Signals",
          "type": "array"
        },
        "has_approved_knowledge_profile": {
          "title": "Has Approved Knowledge Profile",
          "type": "boolean"
        },
        "selected_profile_id": {
          "title": "Selected Profile Id",
          "type": "string"
        },
        "profile_selection_reason": {
          "title": "Profile Selection Reason",
          "type": "string"
        },
        "responses_managed_off_platform": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Responses Managed Off Platform"
        }
      },
      "required": [
        "application_platform",
        "confidence",
        "has_approved_knowledge_profile",
        "selected_profile_id",
        "profile_selection_reason"
      ],
      "title": "AtsDetection",
      "type": "object"
    },
    "AtsPlatform": {
      "enum": [
        "greenhouse",
        "lever",
        "workday",
        "sap_successfactors",
        "ashby",
        "other",
        "unknown"
      ],
      "title": "AtsPlatform",
      "type": "string"
    },
    "AtsSignal": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "2.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "signal_type": {
          "enum": [
            "application_link",
            "document_text",
            "listing_metadata"
          ],
          "title": "Signal Type",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "platform": {
          "$ref": "#/$defs/AtsPlatform"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "weight": {
          "default": 1.0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "signal_type",
        "value",
        "platform"
      ],
      "title": "AtsSignal",
      "type": "object"
    },
    "BlockCategory": {
      "description": "Classification of every extracted content block.\n\n`allowed()` members are employer job content; only `requirement_bearing()` members\nmay enter requirement extraction and scoring.",
      "enum": [
        "job_header",
        "employer_about",
        "employer_role_overview",
        "employer_team",
        "employer_responsibilities",
        "employer_requirements",
        "employer_preferred",
        "employer_work_arrangement",
        "employer_eligibility",
        "employer_compensation",
        "employer_process",
        "employer_application_instructions",
        "employer_eeo",
        "employer_ai_disclosure",
        "linkedin_nav",
        "linkedin_job_match",
        "linkedin_applicant_stats",
        "linkedin_candidate_seniority_stats",
        "linkedin_candidate_education_stats",
        "linkedin_premium_insights",
        "linkedin_company_insights",
        "linkedin_similar_jobs",
        "linkedin_advertisement",
        "linkedin_resume_promotion",
        "linkedin_people_suggestions",
        "page_header_footer",
        "garbled_fragment",
        "unknown"
      ],
      "title": "BlockCategory",
      "type": "string"
    },
    "ContentBlock": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "2.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "block_id": {
          "title": "Block Id",
          "type": "string"
        },
        "page": {
          "title": "Page",
          "type": "integer"
        },
        "order": {
          "title": "Order",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "max_font_size": {
          "title": "Max Font Size",
          "type": "number"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/BlockCategory"
        },
        "allowed_for_requirements": {
          "title": "Allowed For Requirements",
          "type": "boolean"
        },
        "classification_reason": {
          "title": "Classification Reason",
          "type": "string"
        },
        "classifier_rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Classifier Rule"
        },
        "review_required": {
          "default": false,
          "title": "Review Required",
          "type": "boolean"
        },
        "char_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Offset in employer_text when included",
          "title": "Char Start"
        },
        "char_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        }
      },
      "required": [
        "block_id",
        "page",
        "order",
        "y",
        "x",
        "max_font_size",
        "text",
        "category",
        "allowed_for_requirements",
        "classification_reason"
      ],
      "title": "ContentBlock",
      "type": "object"
    },
    "CriticalGap": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "2.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "requirement_id": {
          "title": "Requirement Id",
          "type": "string"
        },
        "requirement_text": {
          "title": "Requirement Text",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "why_critical": {
          "title": "Why Critical",
          "type": "string"
        },
        "what_would_resolve_it": {
          "title": "What Would Resolve It",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "requirement_text",
        "status",
        "why_critical",
        "what_would_resolve_it"
      ],
      "title": "CriticalGap",
      "type": "object"
    },
    "InterviewQuestion": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "2.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "question_id": {
          "title": "Question Id",
          "type": "string"
        },
        "audience": {
          "$ref": "#/$defs/QuestionAudience"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "why_likely": {
          "title": "Why Likely",
          "type": "string"
        },
        "requirement_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Requirement Id"
        },
        "requirement_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Requirement Text"
        },
        "trigger": {
          "title": "Trigger",
          "type": "string"
        },
        "trigger_kind": {
          "enum": [
            "evidence",
            "gap",
            "ambiguity",
            "scope",
            "domain",
            "eligibility"
          ],
          "title": "Trigger Kind",
          "type": "string"
        },
        "suggested_answer_structure": {
          "items": {
            "type": "string"
          },
          "title": "Suggested Answer Structure",
          "type": "array"
        },
        "follow_ups": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Follow Ups",
          "type": "array"
        },
        "note": {
          "default": "Prepare your own answer from real experience. No answer content is generated for you.",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "question_id",
        "audience",
        "question",
        "why_likely",
        "requirement_id",
        "requirement_text",
        "trigger",
        "trigger_kind",
        "suggested_answer_structure"
      ],
      "title": "InterviewQuestion",
      "type": "object"
    },
    "JobDocument": {
