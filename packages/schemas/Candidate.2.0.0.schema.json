{
  "$defs": {
    "ApplicationAnswer": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "question_id": {
          "title": "Question Id",
          "type": "string"
        },
        "question_text": {
          "title": "Question Text",
          "type": "string"
        },
        "answer": {
          "title": "Answer"
        }
      },
      "required": [
        "question_id",
        "question_text",
        "answer"
      ],
      "title": "ApplicationAnswer",
      "type": "object"
    },
    "DocumentFinding": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "DocumentFinding",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "evidence_type": {
          "$ref": "#/$defs/EvidenceType"
        },
        "normalised_concepts": {
          "items": {
            "type": "string"
          },
          "title": "Normalised Concepts",
          "type": "array"
        },
        "source_location": {
          "$ref": "#/$defs/SourceLocation"
        },
        "employer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Employer"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "employment_period": {
          "anyOf": [
            {
              "$ref": "#/$defs/Period"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quantified": {
          "default": false,
          "title": "Quantified",
          "type": "boolean"
        },
        "inferred": {
          "default": false,
          "title": "Inferred",
          "type": "boolean"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "evidence_id",
        "candidate_id",
        "evidence_type",
        "normalised_concepts",
        "source_location",
        "confidence"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "EvidenceType": {
      "enum": [
        "employment_role",
        "employment_achievement",
        "skill_mention",
        "education",
        "certification",
        "summary_statement",
        "explicit_statement_of_absence"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "IngestedDocument": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "resume",
            "job_description"
          ],
          "title": "Kind",
          "type": "string"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "title": "Byte Size",
          "type": "integer"
        },
        "page_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Count"
        },
        "extracted_text": {
          "title": "Extracted Text",
          "type": "string"
        },
        "redacted_text": {
          "default": "",
          "title": "Redacted Text",
          "type": "string"
        },
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "findings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DocumentFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "parser_version": {
          "title": "Parser Version",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "kind",
        "filename",
        "media_type",
        "sha256",
        "byte_size",
        "extracted_text",
        "accepted",
        "parser_version"
      ],
      "title": "IngestedDocument",
      "type": "object"
    },
    "ParseabilityReport": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "text_extraction_success": {
          "title": "Text Extraction Success",
          "type": "boolean"
        },
        "image_only_content": {
          "title": "Image Only Content",
          "type": "boolean"
        },
        "ocr_required": {
          "title": "Ocr Required",
          "type": "boolean"
        },
        "ocr_available": {
          "default": false,
          "title": "Ocr Available",
          "type": "boolean"
        },
        "name_extracted": {
          "title": "Name Extracted",
          "type": "boolean"
        },
        "contact_fields_extracted": {
          "title": "Contact Fields Extracted",
          "type": "boolean"
        },
        "employment_history_extracted": {
          "title": "Employment History Extracted",
          "type": "boolean"
        },
        "dates_extracted": {
          "title": "Dates Extracted",
          "type": "boolean"
        },
        "education_extracted": {
          "title": "Education Extracted",
          "type": "boolean"
        },
        "certifications_extracted": {
          "title": "Certifications Extracted",
          "type": "boolean"
        },
        "section_order_clear": {
          "title": "Section Order Clear",
          "type": "boolean"
        },
        "table_or_column_interference": {
          "title": "Table Or Column Interference",
          "type": "boolean"
        },
        "chronology_conflicts": {
          "title": "Chronology Conflicts",
          "type": "integer"
        },
        "missing_dates": {
          "title": "Missing Dates",
          "type": "integer"
        },
        "duplicate_content": {
          "title": "Duplicate Content",
          "type": "boolean"
        },
        "injection_suspected": {
          "title": "Injection Suspected",
          "type": "boolean"
        },
        "hidden_text_suspected": {
          "title": "Hidden Text Suspected",
          "type": "boolean"
        },
        "parseability_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Parseability Score",
          "type": "number"
        },
        "notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "document_id",
        "text_extraction_success",
        "image_only_content",
        "ocr_required",
        "name_extracted",
        "contact_fields_extracted",
        "employment_history_extracted",
        "dates_extracted",
        "education_extracted",
        "certifications_extracted",
        "section_order_clear",
        "table_or_column_interference",
        "chronology_conflicts",
        "missing_dates",
        "duplicate_content",
        "injection_suspected",
        "hidden_text_suspected",
        "parseability_score"
      ],
      "title": "ParseabilityReport",
      "type": "object"
    },
    "Period": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "YYYY-MM or None if unknown",
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "YYYY-MM, 'present', or None",
          "title": "End"
        },
        "start_uncertain": {
          "default": false,
          "title": "Start Uncertain",
          "type": "boolean"
        },
        "end_uncertain": {
          "default": false,
          "title": "End Uncertain",
          "type": "boolean"
        }
      },
      "title": "Period",
      "type": "object"
    },
    "SourceLocation": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "char_start": {
          "title": "Char Start",
          "type": "integer"
        },
        "char_end": {
          "title": "Char End",
          "type": "integer"
        },
        "text_span": {
          "title": "Text Span",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "char_start",
        "char_end",
        "text_span"
      ],
      "title": "SourceLocation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "document": {
      "$ref": "#/$defs/IngestedDocument"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "parseability": {
      "anyOf": [
        {
          "$ref": "#/$defs/ParseabilityReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "contradictions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Contradictions",
      "type": "array"
    },
    "application_answers": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ApplicationAnswer"
      },
      "title": "Application Answers",
      "type": "array"
    }
  },
  "required": [
    "candidate_id",
    "document"
  ],
  "title": "Candidate",
  "type": "object",
  "$id": "urn:screener:Candidate:2.0.0"
}