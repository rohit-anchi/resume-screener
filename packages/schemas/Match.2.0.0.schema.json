{
  "$defs": {
    "MatchStatus": {
      "enum": [
        "confirmed",
        "strong",
        "partial",
        "weak",
        "no_evidence_located",
        "contradictory",
        "not_assessable",
        "human_review_required"
      ],
      "title": "MatchStatus",
      "type": "string"
    },
    "MatchType": {
      "enum": [
        "direct",
        "equivalent_term",
        "transferable",
        "none"
      ],
      "title": "MatchType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "match_id": {
      "title": "Match Id",
      "type": "string"
    },
    "requirement_id": {
      "title": "Requirement Id",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "match_status": {
      "$ref": "#/$defs/MatchStatus"
    },
    "match_type": {
      "$ref": "#/$defs/MatchType"
    },
    "coverage": {
      "maximum": 1,
      "minimum": 0,
      "title": "Coverage",
      "type": "number"
    },
    "evidence_strength": {
      "maximum": 1,
      "minimum": 0,
      "title": "Evidence Strength",
      "type": "number"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "verification_question": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verification Question"
    },
    "human_review_required": {
      "default": false,
      "title": "Human Review Required",
      "type": "boolean"
    },
    "computed_duration_months": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Computed Duration Months"
    }
  },
  "required": [
    "match_id",
    "requirement_id",
    "evidence_ids",
    "match_status",
    "match_type",
    "coverage",
    "evidence_strength",
    "confidence",
    "reason"
  ],
  "title": "Match",
  "type": "object",
  "$id": "urn:screener:Match:2.0.0"
}